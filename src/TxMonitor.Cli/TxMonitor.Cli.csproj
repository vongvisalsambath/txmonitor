<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>TxMonitor.Cli</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>txmonitor</ToolCommandName>
    <PackageId>TxMonitor.Cli</PackageId>
    <PackageProjectUrl>https://txmonitor.vercel.app</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0</Version>
    <Authors>Vong Visalsambath</Authors>
    <Description>Run transaction monitoring rules over a CSV of transactions and get explained alerts.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/vongvisalsambath/txmonitor</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TxMonitor/TxMonitor.csproj" />
    <InternalsVisibleTo Include="TxMonitor.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
